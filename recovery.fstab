# TWRP recovery.fstab for Redmi Note 13 5G (gold)

# 动态分区
/system        ext4    /dev/block/mapper/system
/system_root   ext4    /dev/block/mapper/system
/system_ext    ext4    /dev/block/mapper/system_ext
/vendor        ext4    /dev/block/mapper/vendor
/product       ext4    /dev/block/mapper/product
/mi_ext        ext4    /dev/block/mapper/mi_ext
/vendor_dlkm   ext4    /dev/block/mapper/vendor_dlkm
/odm_dlkm      ext4    /dev/block/mapper/odm_dlkm
/system_dlkm   ext4    /dev/block/mapper/system_dlkm

# 物理分区
/data          f2fs    /dev/block/by-name/userdata
/metadata      ext4    /dev/block/by-name/metadata
/persist       ext4    /dev/block/by-name/persist
/misc          emmc    /dev/block/by-name/misc
/boot          emmc    /dev/block/by-name/boot
/vendor_boot   emmc    /dev/block/by-name/vendor_boot
/dtbo          emmc    /dev/block/by-name/dtbo
/vbmeta        emmc    /dev/block/by-name/vbmeta
/vbmeta_system emmc    /dev/block/by-name/vbmeta_system
/vbmeta_vendor emmc    /dev/block/by-name/vbmeta_vendor

# MTK 专有
/protect_f     ext4    /dev/block/by-name/protect1
/protect_s     ext4    /dev/block/by-name/protect2
/nvdata        ext4    /dev/block/by-name/nvdata
/nvcfg         ext4    /dev/block/by-name/nvcfg
/nvram         emmc    /dev/block/by-name/nvram
/proinfo       emmc    /dev/block/by-name/proinfo

# 外置存储
/external_sd   auto    /devices/platform/11240000.mmc*
/usb_otg       auto    /devices/platform/mt_usb*